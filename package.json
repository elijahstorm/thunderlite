{
	"name": "thunderlite",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"dev": "vite dev",
		"mock": "dontcode-mock",
		"kv:check": "tsx scripts/kv-check.ts",
		"realtime:check": "tsx scripts/realtime-check.ts",
		"build": "vite build",
		"preview": "vite preview",
		"test": "pnpm run test:integration && pnpm run test:unit",
		"test:integration": "playwright test",
		"test:unit": "vitest run",
		"migrate": "tsx scripts/migrate.ts",
		"migrate:mock": "DONTCODE_API_URL=http://localhost:14000 tsx scripts/migrate.ts",
		"seed:pro": "tsx scripts/seed-pro.ts",
		"seed:pro:mock": "DONTCODE_API_URL=http://localhost:14000 tsx scripts/seed-pro.ts",
		"db:reset": "tsx scripts/reset.ts",
		"db:reset:mock": "DONTCODE_API_URL=http://localhost:14000 tsx scripts/reset.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"type": "module",
	"dependencies": {
		"dontcode": "0.2.9",
		"@iconify/svelte": "5.2.2",
		"@portone/browser-sdk": "0.1.9",
		"as-toast": "1.1.0",
		"base-x": "5.0.1",
		"flowbite-svelte": "1.33.1",
		"svelte-loading-spinners": "0.3.6"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.68.0",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/postcss": "4.3.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "24.13.2",
		"@typescript-eslint/eslint-plugin": "8.62.0",
		"@typescript-eslint/parser": "8.62.0",
		"autoprefixer": "10.5.2",
		"crypto-js": "4.2.0",
		"eslint": "9.39.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.20.0",
		"flowbite": "4.0.2",
		"fp-ts": "2.16.11",
		"globals": "17.7.0",
		"jsdom": "29.1.1",
		"postcss": "8.5.15",
		"prettier": "3.9.1",
		"prettier-plugin-svelte": "3.4.0",
		"svelte": "5.56.4",
		"svelte-check": "4.7.1",
		"tailwindcss": "4.3.1",
		"tslib": "2.8.1",
		"tsx": "4.22.4",
		"typescript": "5.9.3",
		"vi-canvas-mock": "1.0.0",
		"vite": "7.2.7",
		"vitest": "4.1.9"
	}
}
